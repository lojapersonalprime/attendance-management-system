# Copy this file to .env.local and replace only the placeholders.
# .env.local is local-only and must never be committed.

# PostgreSQL / Supabase: server-only connection strings.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Public configuration. These values can be used by the browser when needed.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_PUBLISHABLE_KEY"

# Server-only secret. Never expose this value to the browser or commit a real key.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SECRET_KEY"
SUPABASE_STORAGE_BUCKET="attendance-imports"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Pilot mobile attendance. Keep disabled until the database migration, locations and employee access are configured.
MOBILE_PUNCH_ENABLED="false"
# Server-only HMAC secret for internal receipt hashes (at least 32 random characters).
MOBILE_PUNCH_RECEIPT_SECRET="REPLACE_WITH_A_RANDOM_SERVER_ONLY_SECRET"

# Server-only key for Google Places API (New). Restrict it to the Places API (New)
# and to the Vercel/server egress IPs where available; never prefix it with NEXT_PUBLIC.
GOOGLE_MAPS_API_KEY="REPLACE_WITH_A_RESTRICTED_SERVER_ONLY_KEY"
