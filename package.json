{
  "name": "personal-prime-ponto",
  "version": "0.3.0",
  "description": "Open-source attendance management system with Next.js, Prisma and Supabase.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "setup:check": "tsx scripts/setup-check.ts",
    "setup:storage": "tsx scripts/setup-storage.ts",
    "setup:admin": "tsx scripts/setup-admin.ts",
    "setup:link-admin": "tsx scripts/setup-link-existing-admin.ts",
    "setup:calculation-policies": "tsx scripts/setup-calculation-policies.ts",
    "fixtures:generate": "tsx scripts/generate-synthetic-fixture.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.54.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv": "^16.6.1",
    "eslint": "^9.34.0",
    "eslint-config-next": "16.3.2",
    "postcss": "^8.5.6",
    "prisma": "7.9.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
