generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  RH_ADMIN
  RH_ANALYST
  EMPLOYEE
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  FAILED
  DUPLICATE
}

enum ImportCoverageStatus {
  SUGGESTED
  CONFIRMED
}

enum EmployeeStatus {
  PENDING
  ACTIVE
  ON_LEAVE
  VACATION
  INACTIVE
  TERMINATED
  MERGED
}

enum EmploymentType {
  EMPLOYEE
  INTERN
  APPRENTICE
  CONTRACTOR
  OTHER
}

enum EmploymentPeriodStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum CalculationToleranceMode {
  EXCESS_ONLY
  FULL_EVENT
  IGNORE_WITHIN_TOLERANCE
}

enum EntryToleranceMode {
  FULL_DELAY_AFTER_TOLERANCE
  EXCESS_ONLY_AFTER_TOLERANCE
}

enum CalculationRunTrigger {
  IMPORT
  MOBILE_PUNCH
  EMPLOYMENT_PERIOD_CHANGE
  SCHEDULE_CHANGE
  POLICY_CHANGE
  ADJUSTMENT
  MANUAL_RECALCULATION
  PERIOD_REOPENED
  IMPORT_COVERAGE_CONFIRMED
}

enum MobilePunchLocationStatus {
  INSIDE_RADIUS
  OUTSIDE_RADIUS
  LOW_ACCURACY
}

enum MobilePunchSource {
  MOBILE_BROWSER
}

enum MobilePunchLocationPolicy {
  ALLOW_AND_REVIEW
  BLOCK
}

enum AttendanceCorrectionReason {
  FORGOT_PUNCH
  TIME_REVIEW
  EXTERNAL_WORK
  LOCATION_PROBLEM
  OTHER
}

enum AttendanceCorrectionRequestStatus {
  OPEN
  IN_REVIEW
  APPROVED
  REJECTED
}

enum CalculationRunStatus {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum HrCalculationValidationStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_ADJUSTMENT
}

enum PunchCode {
  S
  E
  A
  F
}

enum CalendarExceptionType {
  DAY_OFF
  VACATION
  LEAVE
  HOLIDAY
  SCHEDULE_OVERRIDE
}

enum DailySummaryStatus {
  PROVISIONAL
  NEEDS_REVIEW
  REGULAR
  CLOSED
}

enum ScheduleTemplateType {
  FIXED
  FLEXIBLE
  ATTENDANCE_ONLY
}

enum InconsistencyType {
  UNKNOWN_EMPLOYEE
  PROVISIONAL_EMPLOYEE
  MISSING_EMPLOYMENT_PERIOD
  OVERLAPPING_EMPLOYMENT_PERIOD
  MISSING_CALCULATION_POLICY
  MISSING_SCHEDULE
  OVERLAPPING_SCHEDULE
  IMPORT_COVERAGE_UNCONFIRMED
  NO_PUNCHES_ON_SCHEDULED_DAY
  ODD_PUNCH_COUNT
  MISSING_ENTRY
  MISSING_EXIT
  MISSING_BREAK_OUT
  MISSING_BREAK_RETURN
  INVALID_SEQUENCE
  POSSIBLE_DUPLICATE
  MULTIPLE_ENTRIES
  MULTIPLE_EXITS
  PUNCH_ON_DAY_OFF
  PUNCH_OUTSIDE_SCHEDULE
  LATE_ARRIVAL
  EARLY_DEPARTURE
  INTERVAL_TOO_SHORT
  INTERVAL_TOO_LONG
  EXCESS_TIME_PENDING
  INCOMPLETE_DAY
  ADJUSTMENT_REQUIRED
  CLOSED_PERIOD_CHANGE_ATTEMPT
  CALCULATION_FAILED
  INVALID_DATETIME
  INVALID_ROW
  UNKNOWN_PUNCH_CODE
  IMPORT_COUNT_MISMATCH
  MOBILE_PUNCH_OUTSIDE_AUTHORIZED_AREA
  MOBILE_PUNCH_LOW_ACCURACY
  MOBILE_PUNCHES_EXCEED_EXPECTED
  ATTENDANCE_CORRECTION_REQUEST
}

enum InconsistencySeverity {
  INFO
  WARNING
  CRITICAL
}

enum InconsistencyStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
  AUTO_RESOLVED
  REOPENED
}

enum AdjustmentType {
  MISSING_PUNCH
  DUPLICATE_PUNCH
  INVALID_PUNCH
  MEDICAL_CERTIFICATE
  JUSTIFIED_ABSENCE
  UNJUSTIFIED_ABSENCE
  EXTERNAL_WORK
  DAY_OFF
  VACATION
  LEAVE
  HOURS_CREDIT
  HOURS_DEBIT
  EXCESS_APPROVAL
  SCHEDULE_CORRECTION
}

enum AdjustmentStatus {
  ACTIVE
  CANCELLED
}

enum ClosingStatus {
  OPEN
  CLOSED
}

model Profile {
  id                             String                        @id @default(cuid())
  authUserId                     String                        @unique
  name                           String
  email                          String                        @unique
  role                           UserRole                      @default(RH_ANALYST)
  active                         Boolean                       @default(true)
  createdAt                      DateTime                      @default(now())
  updatedAt                      DateTime                      @updatedAt
  importedFiles                  ImportFile[]                  @relation("ImportedBy")
  createdExceptions              CalendarException[]           @relation("ExceptionCreatedBy")
  resolvedInconsistencies        Inconsistency[]               @relation("InconsistencyResolvedBy")
  createdAdjustments             Adjustment[]                  @relation("AdjustmentCreatedBy")
  cancelledAdjustments           Adjustment[]                  @relation("AdjustmentCancelledBy")
  auditLogs                      AuditLog[]
  closedPeriods                  ClosingPeriod[]               @relation("PeriodClosedBy")
  reopenedPeriods                ClosingPeriod[]               @relation("PeriodReopenedBy")
  createdScheduleAssignments     EmployeeScheduleAssignment[]  @relation("ScheduleAssignmentCreatedBy")
  confirmedImportCoverage        ImportFile[]                  @relation("ImportCoverageConfirmedBy")
  createdEmploymentPeriods       EmployeeEmploymentPeriod[]    @relation("EmploymentPeriodCreatedBy")
  calculationRuns                CalculationRun[]              @relation("CalculationRunStartedBy")
  hrCalculationValidations       HrCalculationValidation[]     @relation("HrCalculationValidationBy")
  employeeMobileAccess           EmployeeMobileAccess?
  registeredMobilePunches        MobilePunch[]                 @relation("MobilePunchRegisteredBy")
  requestedAttendanceCorrections AttendanceCorrectionRequest[] @relation("AttendanceCorrectionRequestedBy")
  reviewedAttendanceCorrections  AttendanceCorrectionRequest[] @relation("AttendanceCorrectionReviewedBy")

  @@index([active, role])
}

model Device {
  id            String               @id @default(cuid())
  deviceUid     String               @unique
  model         String?
  name          String
  unit          String?
  active        Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  importFiles   ImportFile[]
  rawPunches    RawPunch[]
  employeeLinks EmployeeDeviceLink[]

  @@index([active])
}

model ImportFile {
  id                    String               @id @default(cuid())
  deviceId              String
  originalFilename      String
  safeFilename          String
  fileHash              String               @unique @db.Char(64)
  storagePath           String
  status                ImportStatus         @default(PROCESSING)
  dataType              String
  startPosition         Int?
  declaredLogCount      Int?
  limitPosition         Int?
  totalRows             Int                  @default(0)
  acceptedRows          Int                  @default(0)
  duplicatedRows        Int                  @default(0)
  rejectedRows          Int                  @default(0)
  earliestPunchAt       DateTime?
  latestPunchAt         DateTime?
  coverageFrom          DateTime?            @db.Date
  coverageTo            DateTime?            @db.Date
  coverageStatus        ImportCoverageStatus @default(SUGGESTED)
  coverageConfirmedById String?
  coverageConfirmedAt   DateTime?
  importedById          String?
  failureCode           String?
  failureStage          String?
  failureMessage        String?              @db.Text
  requestId             String?
  startedAt             DateTime             @default(now())
  finishedAt            DateTime?
  createdAt             DateTime             @default(now())
  device                Device               @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  importedBy            Profile?             @relation("ImportedBy", fields: [importedById], references: [id], onDelete: Restrict)
  coverageConfirmedBy   Profile?             @relation("ImportCoverageConfirmedBy", fields: [coverageConfirmedById], references: [id], onDelete: Restrict)
  errors                ImportError[]
  rawPunches            RawPunch[]
  inconsistencies       Inconsistency[]
  calculationRuns       CalculationRun[]

  @@index([deviceId, createdAt])
  @@index([status, createdAt])
  @@index([requestId])
  @@index([coverageStatus, coverageFrom, coverageTo])
}

model ImportError {
  id           String     @id @default(cuid())
  importFileId String
  rowNumber    Int
  rawLine      String?    @db.Text
  errorCode    String
  message      String
  createdAt    DateTime   @default(now())
  importFile   ImportFile @relation(fields: [importFileId], references: [id], onDelete: Restrict)

  @@index([importFileId, rowNumber])
}

model Employee {
  id                           String                        @id @default(cuid())
  fullName                     String
  clockNameRaw                 String?
  registration                 String?                       @unique
  cpf                          String?                       @unique
  legacyPosition               String?                       @map("position")
  legacyDepartment             String?                       @map("department")
  legacyUnit                   String?                       @map("unit")
  employmentType               EmploymentType                @default(EMPLOYEE)
  positionId                   String?
  departmentId                 String?
  unitId                       String?
  admissionDate                DateTime?                     @db.Date
  terminationDate              DateTime?                     @db.Date
  status                       EmployeeStatus                @default(PENDING)
  provisional                  Boolean                       @default(true)
  notes                        String?                       @db.Text
  mergedIntoId                 String?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  position                     Position?                     @relation("EmployeePosition", fields: [positionId], references: [id], onDelete: Restrict)
  department                   Department?                   @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  unit                         Unit?                         @relation("EmployeeUnit", fields: [unitId], references: [id], onDelete: Restrict)
  mergedInto                   Employee?                     @relation("EmployeeMerge", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedEmployees              Employee[]                    @relation("EmployeeMerge")
  deviceLinks                  EmployeeDeviceLink[]
  scheduleAssignments          EmployeeScheduleAssignment[]
  tagAssignments               EmployeeTagAssignment[]
  calendarExceptions           CalendarException[]
  dailySummaries               DailySummary[]
  inconsistencies              Inconsistency[]
  adjustments                  Adjustment[]
  employmentPeriods            EmployeeEmploymentPeriod[]
  calculationRuns              CalculationRun[]
  hrCalculationValidations     HrCalculationValidation[]
  mobileAccess                 EmployeeMobileAccess?
  mobilePunches                MobilePunch[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]

  @@index([status, provisional])
  @@index([fullName])
  @@index([unitId])
  @@index([departmentId])
  @@index([positionId])
  @@index([mergedIntoId])
}

model CalculationPolicy {
  id                            String                     @id @default(cuid())
  name                          String                     @unique
  description                   String?                    @db.Text
  active                        Boolean                    @default(true)
  requiresSchedule              Boolean                    @default(true)
  calculateLateArrival          Boolean                    @default(true)
  calculateEarlyDeparture       Boolean                    @default(true)
  calculateAbsence              Boolean                    @default(true)
  calculateNegativeBalance      Boolean                    @default(true)
  calculateExcessTime           Boolean                    @default(true)
  excessRequiresApproval        Boolean                    @default(true)
  requiresBreak                 Boolean                    @default(false)
  shortBreakGeneratesCredit     Boolean                    @default(false)
  longBreakGeneratesDebit       Boolean                    @default(true)
  allowAutomaticPositiveBalance Boolean                    @default(false)
  attendanceOnly                Boolean                    @default(false)
  flexibleSchedule              Boolean                    @default(false)
  duplicateWindowMinutes        Int                        @default(2)
  entryToleranceMinutes         Int                        @default(0)
  exitToleranceMinutes          Int                        @default(0)
  breakToleranceMinutes         Int                        @default(0)
  toleranceMode                 CalculationToleranceMode   @default(FULL_EVENT)
  entryToleranceMode            EntryToleranceMode         @default(FULL_DELAY_AFTER_TOLERANCE)
  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt
  employmentPeriods             EmployeeEmploymentPeriod[]
  dailySummaries                DailySummary[]

  @@index([active, name])
}

model EmployeeEmploymentPeriod {
  id                  String                 @id @default(cuid())
  employeeId          String
  employmentType      EmploymentType
  calculationPolicyId String?
  validFrom           DateTime               @db.Date
  validUntil          DateTime?              @db.Date
  status              EmploymentPeriodStatus @default(ACTIVE)
  reason              String                 @db.Text
  notes               String?                @db.Text
  createdById         String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  employee            Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  calculationPolicy   CalculationPolicy?     @relation(fields: [calculationPolicyId], references: [id], onDelete: Restrict)
  createdBy           Profile?               @relation("EmploymentPeriodCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  dailySummaries      DailySummary[]

  @@index([employeeId, validFrom])
  @@index([calculationPolicyId])
}

model Unit {
  id                  String                 @id @default(cuid())
  name                String                 @unique
  description         String?                @db.Text
  active              Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  employees           Employee[]             @relation("EmployeeUnit")
  authorizedLocations AuthorizedLocation[]
  mobileAccesses      EmployeeMobileAccess[] @relation("EmployeeMobileAccessUnit")
  mobilePunches       MobilePunch[]

  @@index([active, name])
}

model AuthorizedLocation {
  id                String                    @id @default(cuid())
  unitId            String
  name              String
  placeProvider     String?                   @db.VarChar(40)
  providerPlaceId   String?                   @db.VarChar(255)
  formattedAddress  String?                   @db.Text
  latitude          Float
  longitude         Float
  radiusMeters      Int
  maxAccuracyMeters Int
  exceptionPolicy   MobilePunchLocationPolicy @default(ALLOW_AND_REVIEW)
  active            Boolean                   @default(true)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  unit              Unit                      @relation(fields: [unitId], references: [id], onDelete: Restrict)
  mobilePunches     MobilePunch[]

  @@unique([unitId, name])
  @@index([unitId, active])
  @@index([placeProvider, providerPlaceId])
}

model EmployeeMobileAccess {
  id                String        @id @default(cuid())
  profileId         String        @unique
  employeeId        String        @unique
  allowedUnitId     String
  active            Boolean       @default(true)
  pinHash           String        @db.VarChar(255)
  pinFailedAttempts Int           @default(0)
  pinLockedUntil    DateTime?
  privacyAcceptedAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  profile           Profile       @relation(fields: [profileId], references: [id], onDelete: Restrict)
  employee          Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  allowedUnit       Unit          @relation("EmployeeMobileAccessUnit", fields: [allowedUnitId], references: [id], onDelete: Restrict)
  mobilePunches     MobilePunch[]

  @@index([allowedUnitId, active])
}

model MobilePunch {
  id                         String                        @id @default(cuid())
  employeeId                 String
  employeeMobileAccessId     String
  registeredById             String
  unitId                     String
  authorizedLocationId       String?
  registeredAt               DateTime
  clientObservedAt           DateTime?
  source                     MobilePunchSource             @default(MOBILE_BROWSER)
  latitude                   Float
  longitude                  Float
  accuracyMeters             Float
  distanceFromLocationMeters Float?
  locationStatus             MobilePunchLocationStatus
  reviewRequired             Boolean                       @default(false)
  requestId                  String                        @unique @db.Uuid
  receiptCode                String                        @unique @db.VarChar(32)
  receiptHash                String                        @db.Char(64)
  createdAt                  DateTime                      @default(now())
  employee                   Employee                      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employeeMobileAccess       EmployeeMobileAccess          @relation(fields: [employeeMobileAccessId], references: [id], onDelete: Restrict)
  registeredBy               Profile                       @relation("MobilePunchRegisteredBy", fields: [registeredById], references: [id], onDelete: Restrict)
  unit                       Unit                          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  authorizedLocation         AuthorizedLocation?           @relation(fields: [authorizedLocationId], references: [id], onDelete: Restrict)
  correctionRequests         AttendanceCorrectionRequest[]
  adjustments                Adjustment[]

  @@index([employeeId, registeredAt])
  @@index([unitId, registeredAt])
  @@index([authorizedLocationId, registeredAt])
}

model AttendanceCorrectionRequest {
  id            String                            @id @default(cuid())
  employeeId    String
  mobilePunchId String?
  requestedById String
  businessDate  DateTime                          @db.Date
  reason        AttendanceCorrectionReason
  description   String                            @db.Text
  status        AttendanceCorrectionRequestStatus @default(OPEN)
  reviewedById  String?
  reviewedAt    DateTime?
  reviewReason  String?                           @db.Text
  createdAt     DateTime                          @default(now())
  updatedAt     DateTime                          @updatedAt
  employee      Employee                          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  mobilePunch   MobilePunch?                      @relation(fields: [mobilePunchId], references: [id], onDelete: Restrict)
  requestedBy   Profile                           @relation("AttendanceCorrectionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy    Profile?                          @relation("AttendanceCorrectionReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([employeeId, businessDate])
  @@index([status, createdAt])
}

model Department {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?    @db.Text
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[] @relation("EmployeeDepartment")

  @@index([active, name])
}

model Position {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?    @db.Text
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[] @relation("EmployeePosition")

  @@index([active, name])
}

model EmployeeTag {
  id          String                  @id @default(cuid())
  name        String                  @unique
  description String?                 @db.Text
  active      Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  assignments EmployeeTagAssignment[]

  @@index([active, name])
}

model EmployeeTagAssignment {
  id            String      @id @default(cuid())
  employeeId    String
  employeeTagId String
  createdAt     DateTime    @default(now())
  employee      Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employeeTag   EmployeeTag @relation(fields: [employeeTagId], references: [id], onDelete: Restrict)

  @@unique([employeeId, employeeTagId])
  @@index([employeeTagId])
}

model EmployeeDeviceLink {
  id                     String     @id @default(cuid())
  employeeId             String
  deviceId               String
  externalEmployeeNumber String
  externalEmployeeName   String?
  validFrom              DateTime   @db.Date
  validUntil             DateTime?  @db.Date
  active                 Boolean    @default(true)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  employee               Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  device                 Device     @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  rawPunches             RawPunch[]

  @@index([employeeId, validFrom])
  @@index([deviceId, externalEmployeeNumber, active])
}

model RawPunch {
  id                     String              @id @default(cuid())
  importFileId           String
  deviceId               String
  employeeDeviceLinkId   String?
  externalEmployeeNumber String
  employeeNameRaw        String?
  sourceSequence         Int?
  tmNumber               String?
  gmNumber               String?
  mode                   String?
  punchCode              PunchCode
  punchDescription       String?
  antipass               String?
  daiGong                String?
  occurredAt             DateTime
  originalDateTime       String
  rawLine                String              @db.Text
  fingerprint            String              @unique @db.Char(64)
  createdAt              DateTime            @default(now())
  importFile             ImportFile          @relation(fields: [importFileId], references: [id], onDelete: Restrict)
  device                 Device              @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  employeeDeviceLink     EmployeeDeviceLink? @relation(fields: [employeeDeviceLinkId], references: [id], onDelete: Restrict)
  adjustments            Adjustment[]

  @@index([deviceId, externalEmployeeNumber, occurredAt])
  @@index([employeeDeviceLinkId, occurredAt])
  @@index([importFileId])
  @@index([occurredAt])
}

model ScheduleTemplate {
  id          String                       @id @default(cuid())
  name        String                       @unique
  description String?                      @db.Text
  modelType   ScheduleTemplateType         @default(FIXED)
  active      Boolean                      @default(true)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  days        ScheduleTemplateDay[]
  assignments EmployeeScheduleAssignment[]
}

model ScheduleTemplateDay {
  id                     String           @id @default(cuid())
  scheduleTemplateId     String
  weekday                Int
  isWorkingDay           Boolean          @default(false)
  expectedEntry          String?          @db.VarChar(5)
  expectedBreakStart     String?          @db.VarChar(5)
  expectedBreakEnd       String?          @db.VarChar(5)
  expectedExit           String?          @db.VarChar(5)
  expectedMinutes        Int              @default(0)
  expectedBreakMinutes   Int              @default(0)
  minimumBreakMinutes    Int?
  entryToleranceMinutes  Int              @default(0)
  exitToleranceMinutes   Int              @default(0)
  requiresBreak          Boolean          @default(false)
  excessRequiresApproval Boolean          @default(true)
  scheduleTemplate       ScheduleTemplate @relation(fields: [scheduleTemplateId], references: [id], onDelete: Restrict)

  @@unique([scheduleTemplateId, weekday])
}

model EmployeeScheduleAssignment {
  id                 String           @id @default(cuid())
  employeeId         String
  scheduleTemplateId String
  validFrom          DateTime         @db.Date
  validUntil         DateTime?        @db.Date
  reason             String?          @db.Text
  createdById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  scheduleTemplate   ScheduleTemplate @relation(fields: [scheduleTemplateId], references: [id], onDelete: Restrict)
  createdBy          Profile?         @relation("ScheduleAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  dailySummaries     DailySummary[]

  @@index([employeeId, validFrom])
  @@index([scheduleTemplateId])
}

model CalendarException {
  id              String                @id @default(cuid())
  employeeId      String?
  date            DateTime              @db.Date
  type            CalendarExceptionType
  expectedMinutes Int?
  description     String?               @db.Text
  createdById     String
  createdAt       DateTime              @default(now())
  employee        Employee?             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy       Profile               @relation("ExceptionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([employeeId, date])
  @@index([date, type])
}

model DailySummary {
  id                       String                      @id @default(cuid())
  employeeId               String
  date                     DateTime                    @db.Date
  scheduleAssignmentId     String?
  employmentPeriodId       String?
  calculationPolicyId      String?
  calculationRunId         String?
  expectedMinutes          Int                         @default(0)
  rawWorkedMinutes         Int                         @default(0)
  validWorkedMinutes       Int                         @default(0)
  intervalMinutes          Int                         @default(0)
  positiveMinutes          Int                         @default(0)
  negativeMinutes          Int                         @default(0)
  pendingExcessMinutes     Int                         @default(0)
  recordedMinutes          Int                         @default(0)
  consideredMinutes        Int                         @default(0)
  workedMinutes            Int                         @default(0)
  breakMinutes             Int                         @default(0)
  lateMinutes              Int                         @default(0)
  earlyDepartureMinutes    Int                         @default(0)
  shortBreakMinutes        Int                         @default(0)
  longBreakMinutes         Int                         @default(0)
  rawExcessMinutes         Int                         @default(0)
  absenceMinutes           Int                         @default(0)
  status                   DailySummaryStatus          @default(PROVISIONAL)
  calculationVersion       Int                         @default(1)
  calculationEngineVersion String                      @default("calculation-engine-v1")
  calculationMemory        Json?
  calculatedAt             DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  employee                 Employee                    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  scheduleAssignment       EmployeeScheduleAssignment? @relation(fields: [scheduleAssignmentId], references: [id], onDelete: Restrict)
  employmentPeriod         EmployeeEmploymentPeriod?   @relation(fields: [employmentPeriodId], references: [id], onDelete: Restrict)
  calculationPolicy        CalculationPolicy?          @relation(fields: [calculationPolicyId], references: [id], onDelete: Restrict)
  calculationRun           CalculationRun?             @relation(fields: [calculationRunId], references: [id], onDelete: Restrict)
  inconsistencies          Inconsistency[]
  hrCalculationValidations HrCalculationValidation[]

  @@unique([employeeId, date])
  @@index([date, status])
  @@index([scheduleAssignmentId])
  @@index([employmentPeriodId])
  @@index([calculationPolicyId])
  @@index([calculationRunId])
}

model Inconsistency {
  id                       String                @id @default(cuid())
  employeeId               String?
  dailySummaryId           String?
  importFileId             String?
  date                     DateTime?             @db.Date
  type                     InconsistencyType
  severity                 InconsistencySeverity
  status                   InconsistencyStatus   @default(OPEN)
  description              String                @db.Text
  metadata                 Json?
  resolvedById             String?
  resolvedAt               DateTime?
  resolutionReason         String?               @db.Text
  logicalKey               String?               @db.VarChar(160)
  calculationEngineVersion String?               @db.VarChar(64)
  reconciledAt             DateTime?
  autoResolvedAt           DateTime?
  reopenedAt               DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  employee                 Employee?             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  dailySummary             DailySummary?         @relation(fields: [dailySummaryId], references: [id], onDelete: Restrict)
  importFile               ImportFile?           @relation(fields: [importFileId], references: [id], onDelete: Restrict)
  resolvedBy               Profile?              @relation("InconsistencyResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([status, severity, createdAt])
  @@index([employeeId, date])
  @@index([importFileId])
  @@index([logicalKey])
}

model Adjustment {
  id                    String           @id @default(cuid())
  employeeId            String
  date                  DateTime         @db.Date
  type                  AdjustmentType
  originalPunchId       String?
  originalMobilePunchId String?
  adjustedOccurredAt    DateTime?
  adjustedPunchCode     PunchCode?
  minutesCredited       Int              @default(0)
  minutesDebited        Int              @default(0)
  reason                String           @db.Text
  status                AdjustmentStatus @default(ACTIVE)
  createdById           String
  cancelledById         String?
  cancelledAt           DateTime?
  cancellationReason    String?          @db.Text
  metadata              Json?
  createdAt             DateTime         @default(now())
  employee              Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  originalPunch         RawPunch?        @relation(fields: [originalPunchId], references: [id], onDelete: Restrict)
  originalMobilePunch   MobilePunch?     @relation(fields: [originalMobilePunchId], references: [id], onDelete: Restrict)
  createdBy             Profile          @relation("AdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy           Profile?         @relation("AdjustmentCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)

  @@index([employeeId, date])
  @@index([originalPunchId])
  @@index([originalMobilePunchId])
  @@index([status, createdAt])
}

model CalculationRun {
  id                 String                @id @default(cuid())
  trigger            CalculationRunTrigger
  importFileId       String?
  employeeId         String?
  dateFrom           DateTime              @db.Date
  dateTo             DateTime              @db.Date
  status             CalculationRunStatus  @default(PENDING)
  totalDays          Int                   @default(0)
  processedDays      Int                   @default(0)
  failedDays         Int                   @default(0)
  calculationVersion String                @default("calculation-engine-v1")
  startedById        String?
  startedAt          DateTime?
  finishedAt         DateTime?
  errorCode          String?
  createdAt          DateTime              @default(now())
  importFile         ImportFile?           @relation(fields: [importFileId], references: [id], onDelete: Restrict)
  employee           Employee?             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  startedBy          Profile?              @relation("CalculationRunStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  dailySummaries     DailySummary[]

  @@index([status, createdAt])
  @@index([employeeId, dateFrom, dateTo])
  @@index([importFileId])
}

model HrCalculationValidation {
  id                  String                        @id @default(cuid())
  employeeId          String?
  businessDate        DateTime?                     @db.Date
  dailySummaryId      String?
  expectedCalculation Json?
  calculationSnapshot Json?
  differenceMinutes   Int?
  status              HrCalculationValidationStatus @default(PENDING)
  notes               String?                       @db.Text
  validatedById       String?
  validatedAt         DateTime?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  employee            Employee?                     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  dailySummary        DailySummary?                 @relation(fields: [dailySummaryId], references: [id], onDelete: Restrict)
  validatedBy         Profile?                      @relation("HrCalculationValidationBy", fields: [validatedById], references: [id], onDelete: Restrict)

  @@index([status, businessDate])
  @@index([employeeId, businessDate])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  oldData    Json?
  newData    Json?
  reason     String?  @db.Text
  ipAddress  String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())
  user       Profile  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
}

model ClosingPeriod {
  id             String        @id @default(cuid())
  referenceMonth DateTime      @unique @db.Date
  status         ClosingStatus @default(OPEN)
  closedById     String?
  closedAt       DateTime?
  reopenedById   String?
  reopenedAt     DateTime?
  reopenReason   String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  closedBy       Profile?      @relation("PeriodClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  reopenedBy     Profile?      @relation("PeriodReopenedBy", fields: [reopenedById], references: [id], onDelete: Restrict)

  @@index([status])
}
